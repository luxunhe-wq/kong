[Unit]
Description=MoniLite server resource monitor
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/monilite
ExecStart=/usr/bin/python3 /opt/monilite/server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=MONILITE_DATA_DIR=/var/lib/monilite
StateDirectory=monilite
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
